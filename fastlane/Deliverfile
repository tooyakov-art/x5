app_identifier "com.x5studio.app"
team_id "F8LA8PC4U6"
require File.expand_path("review_credentials", File.dirname(configfile_path))
# Also guard direct `bundle exec fastlane deliver`, which bypasses the lane.
# Do NOT use the printable DSL for credentials: ConfigurationFile's early
# Detected Values table does not mask the nested password in Fastlane 2.237.0.
config.set(:app_review_information, required_review_credentials)

# Push the rewritten metadata in fastlane/metadata/* up to ASC.
skip_metadata false

# Push iPhone 6.9 screenshots captured against the X5 marketplace UI.
# Keep only review-safe screens that match the submitted build.
skip_screenshots false

# Misc
force true
run_precheck_before_submit false
automatic_release false
